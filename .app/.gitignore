# 1. Block virtual environments and IDE system folders completely
.app/
.idea/
**/__pycache__/

# 2. Block all files by default
*

# 3. Allow Git to look inside subdirectories (Crucial for sess01 to sess14)
!*/

# 4. Whitelist only your specific file types globally
!*.py
!*.json
!*.html
!*.txt
!*.png
!.gitignore